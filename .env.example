BOT_TOKEN=your_telegram_bot_token_here
LOG_LEVEL=DEBUG

# Background checks: at most CHECK_CONCURRENCY routes are checked in parallel,
# every attempt is capped by CHECK_TIMEOUT seconds, and RETRY_TIME is the pause
# between check cycles.
CHECK_CONCURRENCY=3
CHECK_TIMEOUT=60
RETRY_TIME=10
# Upper bound for the exponential backoff after failed checks.
RETRY_MAX_DELAY=180
REQUEST_DELAY=0.66

# Telegram proxy (optional): leave PROXY_HOST empty to connect directly.
PROXY_LOGIN=
PROXY_PASSWORD=
PROXY_HOST=
PROXY_PORT=

# pass.rw.by proxy (optional, independent of the Telegram proxy above):
# leave RW_PROXY_HOST empty to request the site directly.
RW_PROXY_LOGIN=
RW_PROXY_PASSWORD=
RW_PROXY_HOST=
RW_PROXY_PORT=

# api.telegram.org is resolved to this address inside the app container.
# Some hosts cannot reach the default Telegram IP, so a working one is pinned.
TELEGRAM_API_IP=149.154.167.220

RW_REQUEST_TIMEOUT=7
RW_RETRY_ATTEMPTS=5
RW_BACKGROUND_REQUEST_TIMEOUT=5
RW_BACKGROUND_RETRY_ATTEMPTS=2
RW_BROWSER_NAVIGATION_TIMEOUT=20000
RW_BROWSER_SELECTOR_TIMEOUT=15000
RW_BROWSER_CASH_ONLY_TIMEOUT=6000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=ppassword
POSTGRES_DB=tickets_data
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Healthcheck (deploy/healthcheck.sh): chat to notify and optional external
# dead-man switch URL (e.g. healthchecks.io), pinged by the timer every 5 min.
ALERT_CHAT_ID=
HEALTHCHECK_URL=
